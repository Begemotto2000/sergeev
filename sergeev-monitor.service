[Unit]
Description=Sergeev Digitization System Monitoring
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/sergeev-100/sergeev_digitization_system/monitor.sh
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
