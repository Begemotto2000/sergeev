[?2004l[?2004h> ## Требования
[?2004l[?2004h> 
[?2004l[?2004h> ### GitLab Runner
[?2004l[?2004h> - Установлен на сервере 46.8.255.137
[?2004l[?2004h> - Docker executor
[?2004l[?2004h> - Доступ к K8s cluster
[?2004l[?2004h> 
[?2004l[?2004h> ### Переменные окружения
[?2004l[?2004h> - `REGISTRY` - Docker registry
[?2004l[?2004h> - `IMAGE_NAME` - Имя Docker image
[?2004l[?2004h> - `IMAGE_TAG` - Tag для image
[?2004l[?2004h> 
[?2004l[?2004h> ## Использование
[?2004l[?2004h> 
[?2004l[?2004h> ### Для запуска pipeline:
[?2004l[?2004h> ```bash
[?2004l[?2004h> git push origin main
[?2004l[?2004h> ```
[?2004l[?2004h> 
[?2004l[?2004h> ### Для просмотра статуса:
[?2004l[?2004h> ```bash
[?2004l[?2004h> # На GitLab UI
[?2004l[?2004h> # https://gitlab.com/your-project/pipelines
[?2004l[?2004h> ```
[?2004l[?2004h> 
[?2004l[?2004h> ### Для отладки:
[?2004l[?2004h> ```bash
[?2004l[?2004h> # На сервере
[?2004l[?2004h> gitlab-runner --debug run
[?2004l[?2004h> ```
[?2004l[?2004h> 
[?2004l[?2004h> ## Troubleshooting
[?2004l[?2004h> 
[?2004l[?2004h> ### Runner не работает
